<!--  ===========================================================================
Categoria: Desempenho - Uso de Disco (Windows)
Descrição: Regras de monitoramento do uso de disco (HDD/SSD) por unidade
em sistemas operacionais Windows atuais: faixas baixo, médio, alto,
muito alto e crítico. Para Windows legados, ver 922-hdd-legacy-rules.xml.
Coleta a cada 5 minutos: o e-mail de uso muito alto é enviado uma vez por
dia (às 8h); o de disco cheio (100%), a cada coleta.
Dependência: decoder windows_hdd_usage (campos usage_percent e drive_letter)

Faixa de IDs:
102700 - 102799
============================================================================= -->

<group name="windows,hdd,ssd,">

  <!-- Regra base: agrupamento inicial para o decoder -->
  <rule id="102700" level="0">
    <decoded_as>windows_hdd_usage</decoded_as>
    <description>Agrupamento de eventos de uso de disco Windows</description>
  </rule>

  <rule id="102701" level="3">
    <if_sid>102700</if_sid>
    <field name="usage_percent" type="pcre2">^[0-4]?[0-9](\.[0-9]+)?$</field>
    <description>Uso de HDD/SSD Windows ($(drive_letter)): baixo ($(usage_percent)%)</description>
  </rule>

  <rule id="102702" level="5">
    <if_sid>102700</if_sid>
    <field name="usage_percent" type="pcre2">^[5-7][0-9](\.[0-9]+)?$</field>
    <description>Uso de HDD/SSD Windows ($(drive_letter)): médio ($(usage_percent)%)</description>
  </rule>

  <rule id="102703" level="7">
    <if_sid>102700</if_sid>
    <field name="usage_percent" type="pcre2">^8[0-9](\.[0-9]+)?$</field>
    <description>Uso de HDD/SSD Windows ($(drive_letter)): alto ($(usage_percent)%)</description>
  </rule>

  <!-- 90 a 99%: alerta no dashboard a cada coleta (5 em 5 minutos), sem e-mail -->
  <rule id="102704" level="10">
    <if_sid>102700</if_sid>
    <field name="usage_percent" type="pcre2">^9[0-9](\.[0-9]+)?$</field>
    <description>Uso de HDD/SSD Windows ($(drive_letter)): muito alto ($(usage_percent)%)</description>
  </rule>

  <rule id="102705" level="13">
    <if_sid>102700</if_sid>
    <field name="usage_percent" type="pcre2">^100(\.0+)?$</field>
    <description>Uso de HDD/SSD Windows ($(drive_letter)): crítico ($(usage_percent)%), disco cheio</description>
    <options>alert_by_email</options>
  </rule>

  <!-- E-mail diário: a coleta das 8h envia um único e-mail por unidade que
       continua acima de 90%, em vez de um e-mail a cada 5 minutos -->
  <rule id="102706" level="12">
    <if_sid>102704</if_sid>
    <time>08:00 - 08:04</time>
    <description>Resumo diário: unidade $(drive_letter) continua com uso muito alto ($(usage_percent)%)</description>
    <options>alert_by_email</options>
  </rule>

</group>
